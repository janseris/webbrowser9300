+	unsigned int b, e;
+	clamp_range(J, 1, 2, vlen(v), &b, &e);
+	r = view_alloc(J, v->kind, e - b);
+	if (e > b) memcpy(r->ab->p, v->ab->p + v->off + b * ksize[v->kind], (e - b) * ksize[v->kind]);
