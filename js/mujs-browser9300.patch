+				dsstep(J, out, decl, idexp(J, k), key);
+				acc = EXP2(INDEX, idexp(J, t), idexp(J, k));
+				bpush(J, &keys, idexp(J, k));
+			}
+			destructure(J, out, decl, e->b, acc);
